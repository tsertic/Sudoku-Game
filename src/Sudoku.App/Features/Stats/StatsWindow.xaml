<Window x:Class="Sudoku.App.Features.Stats.StatsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Scores" SizeToContent="WidthAndHeight" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" Background="{StaticResource PageBrush}"
        FontFamily="Segoe UI">
    <StackPanel Margin="28" MinWidth="460" Grid.IsSharedSizeScope="True">
        <TextBlock Text="Scores" FontSize="28" FontWeight="SemiBold" Foreground="{StaticResource InkBrush}" />
        <TextBlock Text="{Binding Summary}" FontSize="14" Margin="0,2,0,20"
                   Foreground="{StaticResource MutedBrush}" />

        <Grid Margin="12,0,12,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition SharedSizeGroup="level" Width="*" />
                <ColumnDefinition SharedSizeGroup="solved" Width="70" />
                <ColumnDefinition SharedSizeGroup="best" Width="80" />
                <ColumnDefinition SharedSizeGroup="avgTime" Width="80" />
                <ColumnDefinition SharedSizeGroup="avgScore" Width="90" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="LEVEL" Style="{StaticResource HeaderText}" />
            <TextBlock Grid.Column="1" Text="SOLVED" Style="{StaticResource HeaderText}" />
            <TextBlock Grid.Column="2" Text="BEST" Style="{StaticResource HeaderText}" />
            <TextBlock Grid.Column="3" Text="AVG TIME" Style="{StaticResource HeaderText}" />
            <TextBlock Grid.Column="4" Text="AVG SCORE" Style="{StaticResource HeaderText}" />
        </Grid>

        <ItemsControl ItemsSource="{Binding Rows}">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Background="{StaticResource CardBrush}" CornerRadius="8" Padding="12,10" Margin="0,0,0,6">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition SharedSizeGroup="level" Width="*" />
                                <ColumnDefinition SharedSizeGroup="solved" Width="70" />
                                <ColumnDefinition SharedSizeGroup="best" Width="80" />
                                <ColumnDefinition SharedSizeGroup="avgTime" Width="80" />
                                <ColumnDefinition SharedSizeGroup="avgScore" Width="90" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{Binding Level}" FontWeight="SemiBold"
                                       Foreground="{StaticResource InkBrush}" />
                            <TextBlock Grid.Column="1" Text="{Binding Solved}" Foreground="{StaticResource InkBrush}" />
                            <TextBlock Grid.Column="2" Text="{Binding BestTime}" Foreground="{StaticResource InkBrush}" />
                            <TextBlock Grid.Column="3" Text="{Binding AverageTime}" Foreground="{StaticResource InkBrush}" />
                            <TextBlock Grid.Column="4" Text="{Binding AverageScore}" Foreground="{StaticResource InkBrush}" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </StackPanel>
</Window>
